{
  "name": "focus-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "A minimal cross-platform Pomodoro timer.",
  "homepage": "https://github.com/abdurrr2011/personal-focus-timer-desk-app",
  "author": "Abdurakhman",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "smoke": "node tools/smoke-electron.cjs",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/timer.js && node --check src/store.js && node --check src/statistics.js && node --check src/session-history.js && node --check src/csv-export.js && node --check tools/release-artifacts.cjs && node --check renderer/app.js",
    "dist": "npm run check && npm test && electron-builder",
    "dist:win": "npm run check && npm test && electron-builder --win nsis",
    "dist:mac": "npm run check && npm test && electron-builder --mac dmg zip --universal",
    "dist:linux": "npm run check && npm test && electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "build": {
    "appId": "com.focus-tracker.desktop",
    "productName": "Focus Tracker",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/focus-mark.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Focus-Tracker-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "build/focus-mark.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        },
        {
          "target": "zip",
          "arch": ["universal"]
        }
      ],
      "artifactName": "Focus-Tracker-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/focus-mark.png",
      "category": "Utility",
      "maintainer": "Abdurakhman <abdurrr2011@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Focus-Tracker-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": null
  },
  "allowScripts": {
    "electron@45.1.0": true
  }
}
